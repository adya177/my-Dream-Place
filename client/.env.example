# Set this in Vercel to the deployed API URL, with no trailing slash.
VITE_BASE_URL=https://your-api-service.onrender.com

# Optional until Stripe checkout is configured.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: configure an existing seeded demo account to enable one-click login.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
